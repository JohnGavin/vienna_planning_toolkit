{
  "title": "Electrical editor parameters (presets/el_parameters.json)",
  "description": "The one file of user-adjustable parameters of the electrical editor. Validated by vpt/el_layout.py validate() and by the page (same keyword subset) when the Parameters panel loads a file. Semantic checks (colour contrast, rule values) are in vpt/el_params.py validate() and vpt/el_rules.py validate().",
  "type": "object",
  "required": [
    "name",
    "id",
    "version",
    "sections",
    "rules",
    "contrast_min"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "const": "el_parameters",
      "description": "Always el_parameters."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Which parameter family this is (el-params-at); a file of another id is refused."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of the parameter file's layout (semver)."
    },
    "description": {
      "type": "string"
    },
    "standard_note": {
      "type": "string"
    },
    "contrast_min": {
      "type": "number",
      "minimum": 3,
      "description": "Least contrast of every symbol, link, marker and selection colour against its background."
    },
    "contrast_min_note": {
      "type": "string"
    },
    "saved": {
      "type": "string",
      "description": "When the page wrote this file (ISO time); absent in the toolkit's own file."
    },
    "saved_from": {
      "type": "string",
      "description": "Which page wrote it."
    },
    "sections": {
      "type": "object",
      "required": [
        "snap",
        "page",
        "colours_screen",
        "colours_print",
        "drawing_screen",
        "drawing_print",
        "screen_lines",
        "print_lines",
        "examples"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/section"
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "label",
        "note",
        "default_rule_set",
        "rule_sets",
        "definitions",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "default_rule_set": {
          "type": "string",
          "minLength": 1
        },
        "rule_sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule_set"
          }
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/rule_def"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/rule_value"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "label",
        "mark",
        "source",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "mark": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/param"
          }
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "array",
            "null"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "mark": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "rule_set": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "rule_def": {
      "type": "object",
      "required": [
        "label",
        "unit",
        "kind",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "switch",
            "socket",
            "light",
            "kitchen",
            "hint",
            "check"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "rule_value": {
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "array",
            "null"
          ]
        },
        "mark": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
